<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>chess_tutor</name>
  <version>0.1.0</version>
  <description>Voice-controlled chess puzzle tutor robot using Claude (Anthropic API)</description>
  <maintainer email="khyatsharmaoo7@gmail.com">khyat</maintainer>
  <license>MIT</license>

  <buildtool_depend>rosidl_default_generators</buildtool_depend>
<exec_depend>rosidl_default_runtime</exec_depend>
<member_of_group>rosidl_interface_packages</member_of_group>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>chess_tutor_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

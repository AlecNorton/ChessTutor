  <diagram id="chess-tutor-ros" name="ChessTutor ROS flow">
    <mxGraphModel dx="2637" dy="2151" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />

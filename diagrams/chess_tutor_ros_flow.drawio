        </mxCell>
        <mxCell id="e_us_mb" edge="1" parent="1" source="n_emotion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" target="n_moodbridge" value="Emotion snapshot&lt;br&gt;&lt;div&gt;Same JSON stream,&amp;nbsp;&lt;/div&gt;&lt;div&gt;branched for mood&amp;nbsp;&lt;/div&gt;&lt;div&gt;instead of difficulty&lt;/div&gt;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_if_armt" edge="1" parent="1" source="n_chess_if" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" target="n_arm_t" value="Pose and gripper queue&#xa;Ordered targets for Cartesian motion and open or close commands">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

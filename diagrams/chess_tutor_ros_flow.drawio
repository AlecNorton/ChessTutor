        <mxCell id="lane_core" parent="1" style="swimlane;horizontal=1;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" value="Chess tutor core (chess_tutor package)" vertex="1">
          <mxGeometry height="500" width="1210" x="730" y="140" as="geometry" />
        </mxCell>
        <mxCell id="n_voice" parent="lane_core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;voice_node&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Always-on microphone path: wake word, short recording, speech-to-text. Suppresses listening while synthesized speech is playing so the robot does not answer itself.&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="268" x="10" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n_tutor" parent="lane_core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;tutor_node&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Bridges user language, current puzzle, and mood into the AI tutor. Returns a suggested move, whether it matches the solution line, coaching text, and optional confidence judgments.&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="292" x="530" y="50" as="geometry" />
        </mxCell>
        <mxCell id="n_tts" parent="lane_core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;tts_node&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Turns text into audio with a local voice model, plays it on speakers, and announces when it is actively speaking so voice capture can pause.&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="268" x="910" y="310" as="geometry" />
        </mxCell>
        <mxCell id="n_puzzle" parent="lane_core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4c3;strokeColor=#d6b656;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;puzzle_node&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Owns the puzzle lifecycle: pick rating, apply setup moves, publish board state, accept correct tutor moves, auto-play replies, narrate milestones, and shift difficulty from fused confidence.&lt;/font&gt;" vertex="1">

        <mxCell id="n_emotion" parent="lane_p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;emotion_node&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Captures webcam frames and runs facial expression analysis. Continuously emits a structured map of how much each expression is present.&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="248" x="36" y="40" as="geometry" />
        </mxCell>
        <mxCell id="e_us_fc" edge="1" parent="lane_p" source="n_emotion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=16;labelBackgroundColor=#ffffff;spacingTop=2;strokeWidth=2;" target="n_faceconf" value="Emotion snapshot from current frame">

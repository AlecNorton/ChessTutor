<mxfile host="app.diagrams.net" agent="ChessTutor">
  <diagram id="chess-tutor-ros" name="ChessTutor ROS flow">
    <mxGraphModel dx="888" dy="579" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=1;fontSize=20;" value="ChessTutor — ROS 2 node flow" vertex="1">
          <mxGeometry height="40" width="800" x="900" y="20" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#404040;spacingLeft=4;" value="Arrow labels describe what travels on the link and why it matters. Dashed links go through components not packaged in this repo.&#xa;Two parallel paths from the camera: confidence (0–1) adjusts puzzle difficulty; mood (signed valence) nudges how the tutor speaks." vertex="1">
          <mxGeometry height="56" width="2500" x="48" y="68" as="geometry" />
        </mxCell>
        <mxCell id="lane_p" parent="1" style="swimlane;horizontal=1;startSize=34;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" value="Perception and confidence" vertex="1">
          <mxGeometry height="500" width="680" x="48" y="140" as="geometry" />
        </mxCell>
        <mxCell id="n_agg" parent="lane_p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;b&gt;aggregator_node&lt;/b&gt; (user_confidence)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Subscribes to multiple feeds, weights them all together, and outputs a full score. Currently only receives confidence score, but can receive more scores&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="248" x="24" y="370" as="geometry" />
        </mxCell>
        <mxCell id="n_faceconf" parent="lane_p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;b&gt;face_confidence_node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Converts emotion percentages into one smoothed score: how calm or engaged the face looks, scale of [0, 1]&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="248" x="24" y="216" as="geometry" />
        </mxCell>
        <mxCell id="e_fc_agg" edge="1" parent="lane_p" source="n_faceconf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" target="n_agg" value="Face confidence sample&#xa;Smoothed zero-to-one signal for how the student appears to be doing">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n_moodbridge" parent="lane_p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;b&gt;mood_bridge_node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Reads the same emotion JSON and maps it to a signed valence: roughly frustrated versus positive, for the tutoring tone path rather than difficulty.&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="248" x="432" y="52" as="geometry" />
        </mxCell>
        <mxCell id="lane_core" parent="1" style="swimlane;horizontal=1;startSize=34;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" value="Chess tutor core (chess_tutor package)" vertex="1">
          <mxGeometry height="500" width="1822" x="730" y="140" as="geometry" />
        </mxCell>
        <mxCell id="n_voice" parent="lane_core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;b&gt;voice_node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Always-on microphone path: wake word, short recording, speech-to-text. Suppresses listening while synthesized speech is playing so the robot does not answer itself.&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="268" x="70" y="42" as="geometry" />
        </mxCell>
        <mxCell id="n_tutor" parent="lane_core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;b&gt;tutor_node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Bridges user language, current puzzle, and mood into the AI tutor. Returns a suggested move, whether it matches the solution line, coaching text, and optional confidence judgments.&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="292" x="766" y="40" as="geometry" />
        </mxCell>
        <mxCell id="n_tts" parent="lane_core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;b&gt;tts_node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Turns text into audio with a local voice model, plays it on speakers, and announces when it is actively speaking so voice capture can pause.&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="268" x="1360" y="330" as="geometry" />
        </mxCell>
        <mxCell id="n_puzzle" parent="lane_core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4c3;strokeColor=#d6b656;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;b&gt;puzzle_node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Owns the puzzle lifecycle: pick rating, apply setup moves, publish board state, accept correct tutor moves, auto-play replies, narrate milestones, and shift difficulty from fused confidence.&lt;/font&gt;" vertex="1">
          <mxGeometry height="138" width="380" x="150" y="350" as="geometry" />
        </mxCell>
        <mxCell id="n_board" parent="lane_core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;b&gt;board_viewer_node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Optional human-facing board window: mirrors the live puzzle message so operators see pieces, side to move, and completion without reading logs.&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="292" x="900" y="355" as="geometry" />
        </mxCell>
        <mxCell id="e_vc_tu" edge="1" parent="lane_core" source="n_voice" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" target="n_tutor" value="User utterance text&#xa;Transcript of what the human said after the wake cue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_pz_tu" edge="1" parent="lane_core" source="n_puzzle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" target="n_tutor" value="Authoritative puzzle state&#xa;FEN, solution line, progress flags, and metadata for reasoning">
          <mxGeometry relative="1" x="-0.0883" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="250" y="210" />

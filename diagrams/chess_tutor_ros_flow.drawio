            <mxPoint x="290" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_tu_tts" edge="1" parent="lane_core" source="n_tutor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" target="n_tts" value="Coach spoken line&#xa;Natural-language reply to read aloud to the student">
          <mxGeometry relative="1" x="-0.3897" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_pz_tts" edge="1" parent="lane_core" source="n_puzzle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" value="System narration&#xa;Puzzle intros, opponent replies, and completion announcements">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="320" />
              <mxPoint x="1310" y="320" />
              <mxPoint x="1310" y="400" />
            </Array>
            <mxPoint x="1360" y="400" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e_tts_vc" edge="1" parent="lane_core" source="n_tts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.993;entryY=0.836;entryDx=0;entryDy=0;entryPerimeter=0;" target="n_voice" value="Playback busy flag&#xa;Tells listening logic to ignore the mic while audio is playing">
          <mxGeometry relative="1" x="-0.447" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="1464" y="230" />

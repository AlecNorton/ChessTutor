        <mxCell id="n_board" parent="lane_core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#666666;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;board_viewer_node&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Optional human-facing board window: mirrors the live puzzle message so operators see pieces, side to move, and completion without reading logs.&lt;/font&gt;" vertex="1">

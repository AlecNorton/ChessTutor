        <mxCell id="e_pz_bd" edge="1" parent="lane_core" source="n_puzzle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" target="n_board" value="Authoritative puzzle state&#xa;Same board snapshot for the visual debug window">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="lane_proj" parent="1" style="swimlane;horizontal=1;startSize=34;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=13;" value="Projector (chess_projector) — separate display pipeline" vertex="1">
          <mxGeometry height="380" width="540" x="48" y="680" as="geometry" />
        </mxCell>
        <mxCell id="n_projector" parent="lane_proj" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;b&gt;combined_node&lt;/b&gt; or &lt;b&gt;projector_node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Full-screen or windowed renderer: calibrated board region plus animated avatar for physical projection or a large monitor.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="416" x="80" y="270" as="geometry" />
        </mxCell>
        <mxCell id="n_proj_topics" parent="lane_proj" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;b&gt;Chess overlay producers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;External or custom nodes can send which square to emphasize, which piece type to illustrate rays for, and when to clear highlights.&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="248" x="12" y="58" as="geometry" />
        </mxCell>
        <mxCell id="e_pr1" edge="1" parent="lane_proj" source="n_proj_topics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" target="n_projector" value="Board highlight commands&lt;br&gt;&lt;div&gt;Focus square,&amp;nbsp;&lt;/div&gt;&lt;div&gt;piece semantics,&amp;nbsp;&lt;/div&gt;&lt;div&gt;and reset cues&amp;nbsp;&lt;/div&gt;&lt;div&gt;for the projected board&lt;/div&gt;">
          <mxGeometry relative="1" x="0.0033" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="136" y="250" />
              <mxPoint x="136" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="n_avatar_topics" parent="lane_proj" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;b&gt;Avatar overlay producers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;External or custom nodes can set projected mood, a short caption under the face, and a color theme for encouragement or tension.&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="248" x="292" y="58" as="geometry" />
        </mxCell>
        <mxCell id="e_pr2" edge="1" parent="lane_proj" source="n_avatar_topics" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;" target="n_projector" value="Avatar directives&lt;br&gt;&lt;div&gt;Expression, caption text,&amp;nbsp;&lt;/div&gt;&lt;div&gt;and palette for the projected character&lt;/div&gt;">
          <mxGeometry relative="1" x="-0.0034" as="geometry">

          <mxGeometry height="40" width="800" x="900" y="20" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#b3b3b3;fillColor=#ffffff;align=left;verticalAlign=top;fontSize=13;fontColor=#404040;spacingLeft=8;spacingTop=6;spacingRight=8;spacingBottom=6;" value="Arrow labels describe what travels on the link and why it matters. Dashed links go through components not packaged in this repo.&#xa;Two parallel paths from the camera: confidence (0–1) adjusts puzzle difficulty; mood (signed valence) nudges how the tutor speaks." vertex="1">
          <mxGeometry height="56" width="2500" x="48" y="68" as="geometry" />
        </mxCell>
        <mxCell id="lane_p" parent="1" style="swimlane;horizontal=1;startSize=34;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;" value="Perception and confidence" vertex="1">
          <mxGeometry height="510" width="320" x="410" y="140" as="geometry" />
        </mxCell>
        <mxCell id="n_agg" parent="lane_p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;aggregator_node&lt;/font&gt;&lt;/b&gt; (user_confidence)&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Subscribes to multiple feeds, weights them all together, and outputs a full score. Currently only receives confidence score, but can receive more scores&lt;/font&gt;" vertex="1">
          <mxGeometry height="130" width="248" x="36" y="370" as="geometry" />
        </mxCell>
        <mxCell id="n_faceconf" parent="lane_p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b&gt;face_confidence_node&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Converts emotion percentages into one smoothed score: how calm or engaged the face looks, scale of [0, 1]&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="248" x="24" y="210" as="geometry" />
        </mxCell>
        <mxCell id="e_fc_agg" edge="1" parent="lane_p" source="n_faceconf" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=16;labelBackgroundColor=#ffffff;exitX=0.451;exitY=0.985;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.868;entryY=0.003;entryDx=0;entryDy=0;entryPerimeter=0;strokeWidth=2;" target="n_agg" value="Translated emotion-&amp;gt;confidence">

        </mxCell>
        <mxCell id="lane_arm" parent="1" style="swimlane;horizontal=1;startSize=34;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" value="Arm control — separate hardware pipeline" vertex="1">
          <mxGeometry height="380" width="1932" x="620" y="680" as="geometry" />
        </mxCell>
        <mxCell id="n_emotion" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;b&gt;emotion_node&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Captures webcam frames and runs facial expression analysis. Continuously emits a structured map of how much each expression is present.&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="248" x="72" y="192" as="geometry" />
        </mxCell>
        <mxCell id="n_chess_if" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;b&gt;chess_interface&lt;/b&gt; (arm_control, input)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Watches board state messages and turns chess moves into timed gripper trajectories: approach, grasp, place, captures, and return home.&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="312" x="652" y="738" as="geometry" />
        </mxCell>
        <mxCell id="n_arm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;b&gt;arm_control&lt;/b&gt; (arm)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Joint-space bridge: receives target angles for the arm chain and asks the manipulator stack to execute a timed joint trajectory.&lt;/font&gt;" vertex="1">
          <mxGeometry height="100" width="292" x="652" y="902" as="geometry" />
        </mxCell>
        <mxCell id="n_arm_t" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;b&gt;arm_control_task&lt;/b&gt; (arm_t)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Task-space bridge: receives Cartesian gripper poses and orientation and requests Cartesian motion through the vendor interface.&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="292" x="1008" y="738" as="geometry" />
        </mxCell>
        <mxCell id="n_chess_cpp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;fontStyle=0;" value="&lt;b&gt;chess_control&lt;/b&gt; (C++, playground)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MoveIt executor: plans and runs arm and named gripper poses from the same pose stream as the task-space Python node.&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="312" x="1352" y="738" as="geometry" />
        </mxCell>
        <mxCell id="n_om" parent="1" style="shape=process;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=10;spacingTop=6;spacingRight=8;spacingBottom=6;verticalAlign=top;" value="&lt;b&gt;Open Manipulator stack&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Robot-specific controllers and services that plan or stream motion to the real arm and gripper hardware.&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="300" x="1748" y="752" as="geometry" />
        </mxCell>
        <mxCell id="note_weights" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff9e6;strokeColor=#d6b656;align=left;fontSize=11;spacingLeft=8;" value="Extra sensors can feed the confidence aggregator as additional named sources; see user_confidence weights configuration in the repo." vertex="1">
          <mxGeometry height="72" width="480" x="48" y="1088" as="geometry" />
        </mxCell>
        <mxCell id="e_us_fc" edge="1" parent="1" source="n_emotion" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;spacingTop=2;" target="n_faceconf" value="Emotion snapshot&#xa;Structured expression strengths from the current frame">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_agg_pz" edge="1" parent="1" source="n_agg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;fontSize=11;labelBackgroundColor=#ffffff;entryX=0.003;entryY=0.386;entryDx=0;entryDy=0;entryPerimeter=0;" target="n_puzzle" value="Fused user confidence&#xa;Single number the puzzle engine uses to nudge rating up or down">
          <mxGeometry relative="1" x="-0.1971" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="340" y="543" />
              <mxPoint x="340" y="620" />
